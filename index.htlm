<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>OshiStock - 推しグッズ管理</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- React & ReactDOM & Babel -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            pink: {
              50: '#fff1f2', 100: '#ffe4e6', 200: '#fecdd3', 300: '#fda4af',
              400: '#fb7185', 500: '#f43f5e', 600: '#e11d48', 700: '#be123c'
            },
            blue: {
              50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
              400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1'
            }
          },
          borderRadius: { 'xl': '1rem', '2xl': '1.5rem', '3xl': '2rem' }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "ヒラギノ角ゴ ProN W3", Meiryo, sans-serif;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .pb-safe { padding-bottom: env(safe-area-inset-bottom, 24px); }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo } = React;

    const INITIAL_CATEGORIES = [
      { id: 'cat-1', name: '缶バッジ', emoji: '🎀' },
      { id: 'cat-2', name: 'アクスタ', emoji: '✨' },
      { id: 'cat-3', name: 'ぬいぐるみ', emoji: '🧸' },
      { id: 'cat-4', name: 'その他', emoji: '📦' }
    ];

    function App() {
      const [theme, setTheme] = useState(() => localStorage.getItem('oshistock_theme') || 'pink');
      const [tab, setTab] = useState('home'); // home, items, trades, stats, settings
      const [items, setItems] = useState(() => {
        const saved = localStorage.getItem('oshistock_items');
        return saved ? JSON.parse(saved) : [];
      });
      const [trades, setTrades] = useState(() => {
        const saved = localStorage.getItem('oshistock_trades');
        return saved ? JSON.parse(saved) : [];
      });
      const [categories, setCategories] = useState(() => {
        const saved = localStorage.getItem('oshistock_categories');
        return saved ? JSON.parse(saved) : INITIAL_CATEGORIES;
      });

      // 編集・詳細モーダル
      const [editingItem, setEditingItem] = useState(null);
      const [viewingItem, setViewingItem] = useState(null);
      const [searchQuery, setSearchQuery] = useState('');
      const [selectedCategory, setSelectedCategory] = useState('');

      useEffect(() => {
        localStorage.setItem('oshistock_theme', theme);
        localStorage.setItem('oshistock_items', JSON.stringify(items));
        localStorage.setItem('oshistock_trades', JSON.stringify(trades));
        localStorage.setItem('oshistock_categories', JSON.stringify(categories));
      }, [theme, items, trades, categories]);

      const primaryBg = theme === 'pink' ? 'bg-gradient-to-r from-rose-400 to-pink-500' : 'bg-gradient-to-r from-sky-400 to-blue-500';
      const solidPrimary = theme === 'pink' ? 'bg-pink-500' : 'bg-blue-500';
      const primaryText = theme === 'pink' ? 'text-pink-600' : 'text-blue-600';
      const lightCardBg = theme === 'pink' ? 'bg-gradient-to-br from-pink-50/60 to-rose-50/30' : 'bg-gradient-to-br from-blue-50/60 to-sky-50/30';

      // 統計計算
      const stats = useMemo(() => {
        let totalTypes = items.length;
        let totalQty = 0;
        let ownedQty = 0;
        let tradeQty = 0;
        let giveQty = 0;
        let totalPrice = 0;
        let unpricedCount = 0;

        items.forEach(item => {
          const o = Number(item.qty_owned || 0);
          const t = Number(item.qty_trade || 0);
          const g = Number(item.qty_give || 0);
          ownedQty += o;
          tradeQty += t;
          giveQty += g;
          totalQty += (o + t + g);

          if (item.has_price && item.purchase_price !== '') {
            totalPrice += Number(item.purchase_price) * Number(item.purchase_quantity || 1);
          } else {
            unpricedCount++;
          }
        });

        const activeTradesCount = trades.filter(tr => tr.status !== '完了' && tr.status !== 'キャンセル').length;

        return { totalTypes, totalQty, ownedQty, tradeQty, giveQty, totalPrice, unpricedCount, activeTradesCount };
      }, [items, trades]);

      // バックアップ出力
      const handleExport = () => {
        const data = { version: '1.0', exported_at: new Date().toISOString(), items, trades, categories };
        const dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `oshistock_backup_${dateStr}.json`;
        a.click();
        URL.revokeObjectURL(url);
      };

      // バックアップ取り込み
      const handleImport = (e, mode) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const imported = JSON.parse(event.target.result);
            if (!imported.items) {
              alert('有効なOshiStockデータではありません。');
              return;
            }
            if (mode === 'replace') {
              if (confirm('現在のデータをすべて上書きして復元しますか？')) {
                setItems(imported.items || []);
                setTrades(imported.trades || []);
                if (imported.categories) setCategories(imported.categories);
                alert('データを復元しました！');
              }
            } else {
              setItems(prev => [...prev, ...(imported.items || [])]);
              setTrades(prev => [...prev, ...(imported.trades || [])]);
              alert('データを追加で取り込みました！');
            }
          } catch (err) {
            alert('JSONファイルの読み込みに失敗しました。');
          }
        };
        reader.readAsText(file);
      };

      return (
        <div className="max-w-md mx-auto min-h-screen flex flex-col bg-slate-50 relative pb-24">
          
          {/* ヘッダーバー */}
          <header className={`p-4 ${solidPrimary} text-white shadow-sm flex justify-between items-center sticky top-0 z-20`}>
            <div>
              <h1 className="text-lg font-bold tracking-wider">OshiStock</h1>
              <p className="text-[11px] text-white/80">わたしの推しコレクション</p>
            </div>
            <button
              onClick={() => setEditingItem({ item_name: '', work_title: '', qty_owned: 1, purchase_quantity: 1, is_public: false })}
              className="bg-white text-slate-800 px-3 py-1.5 rounded-full text-xs font-bold shadow-sm flex items-center gap-1"
            >
              <span>＋ 登録</span>
            </button>
          </header>

          {/* メインコンテンツ */}
          <main className="flex-1 p-4 space-y-4">

            {/* ホームタブ */}
            {tab === 'home' && (
              <div className="space-y-4">
                
                {/* ヒーローカード (画像6のデザイン再現) */}
                <div className={`${lightCardBg} rounded-3xl p-5 border border-pink-100/60 shadow-sm space-y-3 relative overflow-hidden`}>
                  <div className="absolute -right-4 -bottom-4 text-6{-} opacity-10">🎀</div>
                  <h2 className="text-lg font-extrabold text-slate-800">わたしの推しコレクション</h2>
                  <p className="text-xs text-slate-600 leading-relaxed">
                    グッズの数量・金額・保管場所・交換や譲渡の取引まで、ひとつのアプリでまとめて管理できます。
                  </p>
                  <div className="flex gap-2 pt-1">
                    <button
                      onClick={() => setEditingItem({ item_name: '', work_title: '', qty_owned: 1, purchase_quantity: 1 })}
                      className={`flex-1 py-3 ${solidPrimary} text-white rounded-2xl text-xs font-bold shadow-md flex items-center justify-center gap-1.5`}
                    >
                      <span>＋ グッズを登録</span>
                    </button>
                  </div>
                </div>

                {/* 4大サマリーカード */}
                <div className="grid grid-cols-2 gap-3">
                  
                  {/* グッズの種類 */}
                  <div onClick={() => setTab('items')} className="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm cursor-pointer hover:border-slate-300 space-y-1">
                    <div className="text-xs text-slate-400 font-medium flex items-center gap-1">📦 グッズの種類</div>
                    <div className="text-2xl font-black text-slate-800">{stats.totalTypes} <span className="text-xs font-normal text-slate-500">点</span></div>
                  </div>

                  {/* 合計数量 */}
                  <div onClick={() => setTab('items')} className="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm cursor-pointer hover:border-slate-300 space-y-1">
                    <div className="text-xs text-slate-400 font-medium flex items-center gap-1">💎 合計数量</div>
                    <div className="text-2xl font-black text-slate-800">{stats.totalQty} <span className="text-xs font-normal text-slate-500">個</span></div>
                    <div className="text-[10px] text-slate-400">所持{stats.ownedQty}・交換{stats.tradeQty}・譲渡{stats.giveQty}</div>
                  </div>

                  {/* 購入金額合計 */}
                  <div onClick={() => setTab('stats')} className="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm cursor-pointer hover:border-slate-300 space-y-1">
                    <div className="text-xs text-slate-400 font-medium flex items-center gap-1">💴 購入金額合計</div>
                    <div className="text-xl font-black text-slate-800">¥{stats.totalPrice.toLocaleString()}</div>
                    {stats.unpricedCount > 0 ? (
                      <div className="text-[10px] text-amber-600">価格未入力{stats.unpricedCount}点除く</div>
                    ) : (
                      <div className="text-[10px] text-emerald-600">全価格入力済み</div>
                    )}
                  </div>

                  {/* 取引中 */}
                  <div onClick={() => setTab('trades')} className="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm cursor-pointer hover:border-slate-300 space-y-1">
                    <div className="text-xs text-slate-400 font-medium flex items-center gap-1">🤝 取引中</div>
                    <div className="text-2xl font-black text-slate-800">{stats.activeTradesCount} <span className="text-xs font-normal text-slate-500">件</span></div>
                    <div className="text-[10px] text-slate-400">募集中〜受け取り待ち</div>
                  </div>

                </div>

                {/* 最近登録したグッズ一覧 */}
                <div className="space-y-2 pt-2">
                  <div className="flex justify-between items-center">
                    <h3 className="font-bold text-slate-700 text-sm">最近登録したグッズ</h3>
                    <button onClick={() => setTab('items')} className={`text-xs ${primaryText} font-bold`}>すべて見る ➔</button>
                  </div>
                  {items.length === 0 ? (
                    <div className="bg-white rounded-2xl p-8 text-center text-slate-400 border border-slate-100 text-xs">
                      まだグッズが登録されていません。上のボタンから追加してみましょう！
                    </div>
                  ) : (
                    <div className="grid grid-cols-2 gap-3">
                      {items.slice(0, 4).map(item => (
                        <div key={item.id} onClick={() => setViewingItem(item)} className="bg-white rounded-2xl p-3 border border-slate-100 shadow-sm cursor-pointer">
                          <div className="aspect-square bg-slate-100 rounded-xl mb-2 overflow-hidden flex items-center justify-center">
                            {item.image_url ? (
                              <img src={item.image_url} alt="" className="w-full h-full object-cover" />
                            ) : (
                              <span className="text-3xl">🎁</span>
                            )}
                          </div>
                          <div className="text-[10px] text-slate-400 truncate">{item.work_title || '作品名なし'}</div>
                          <div className="font-bold text-xs text-slate-800 truncate">{item.item_name}</div>
                          <div className="text-[11px] font-semibold text-slate-600 mt-1">所持: {item.qty_owned || 0} 個</div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

              </div>
            )}

            {/* グッズ一覧タブ */}
            {tab === 'items' && (
              <div className="space-y-3">
                <input
                  type="text"
                  placeholder="グッズ名・作品名で検索..."
                  value={searchQuery}
                  onChange={e => setSearchQuery(e.target.value)}
                  className="w-full bg-white p-3 rounded-2xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-pink-400"
                />
                <div className="grid grid-cols-2 gap-3">
                  {items.filter(i => !searchQuery || i.item_name.includes(searchQuery) || (i.work_title && i.work_title.includes(searchQuery))).map(item => (
                    <div key={item.id} onClick={() => setViewingItem(item)} className="bg-white rounded-2xl p-3 border border-slate-100 shadow-sm cursor-pointer">
                      <div className="aspect-square bg-slate-100 rounded-xl mb-2 overflow-hidden flex items-center justify-center">
                        {item.image_url ? <img src={item.image_url} alt="" className="w-full h-full object-cover" /> : <span className="text-3xl">🎀</span>}
                      </div>
                      <div className="text-[10px] text-slate-400 truncate">{item.work_title}</div>
                      <div className="font-bold text-xs text-slate-800 truncate">{item.item_name}</div>
                      <div className="text-[11px] font-semibold text-slate-600 mt-1">所持: {item.qty_owned} 個</div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* 取引タブ */}
            {tab === 'trades' && (
              <div className="space-y-3">
                <div className="bg-white rounded-2xl p-4 border shadow-sm flex justify-between items-center">
                  <h3 className="font-bold text-xs text-slate-700">交換・譲渡の取引一覧</h3>
                  <button onClick={() => setTrades([...trades, { id: 't_' + Date.now(), trade_type: 'exchange', status: '募集中', partner_name: '新しいお相手' }])} className={`px-3 py-1.5 ${solidPrimary} text-white rounded-full text-xs font-bold`}>＋ 取引追加</button>
                </div>
                {trades.map(t => (
                  <div key={t.id} className="bg-white p-4 rounded-2xl border shadow-sm flex justify-between items-center">
                    <div>
                      <span className="text-[10px] bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded-full font-bold">{t.trade_type === 'exchange' ? '交換' : '譲渡'}</span>
                      <div className="font-bold text-xs text-slate-800 mt-1">お相手: {t.partner_name}</div>
                    </div>
                    <span className="text-xs bg-slate-100 px-2.5 py-1 rounded-full text-slate-600 font-medium">{t.status}</span>
                  </div>
                ))}
              </div>
            )}

            {/* 集計タブ */}
            {tab === 'stats' && (
              <div className="bg-white rounded-3xl p-5 border shadow-sm space-y-3">
                <h3 className="font-bold text-sm text-slate-800">購入金額・数量内訳</h3>
                <div className="flex justify-between text-xs border-b pb-2"><span className="text-slate-500">総所持数</span><span className="font-bold">{stats.totalQty} 個</span></div>
                <div className="flex justify-between text-xs border-b pb-2"><span className="text-slate-500">購入総額</span><span className={`font-bold text-sm ${primaryText}`}>¥{stats.totalPrice.toLocaleString()}</span></div>
              </div>
            )}

            {/* 設定タブ */}
            {tab === 'settings' && (
              <div className="space-y-4">
                <div className="bg-white rounded-3xl p-5 border shadow-sm space-y-3">
                  <h3 className="font-bold text-sm text-slate-800">テーマカラー設定</h3>
                  <div className="flex gap-2">
                    <button onClick={() => setTheme('pink')} className={`flex-1 py-2.5 rounded-2xl text-xs font-bold ${theme === 'pink' ? 'bg-pink-500 text-white' : 'bg-slate-100 text-slate-600'}`}>ピンク</button>
                    <button onClick={() => setTheme('blue')} className={`flex-1 py-2.5 rounded-2xl text-xs font-bold ${theme === 'blue' ? 'bg-blue-500 text-white' : 'bg-slate-100 text-slate-600'}`}>ブルー</button>
                  </div>
                </div>

                <div className="bg-white rounded-3xl p-5 border shadow-sm space-y-3">
                  <h3 className="font-bold text-sm text-slate-800">バックアップデータ</h3>
                  <button onClick={handleExport} className="w-full py-3 bg-slate-800 text-white text-xs font-bold rounded-2xl shadow-sm">JSONファイルで保存（ダウンロード）</button>
                  <label className="block w-full py-2.5 bg-slate-100 text-slate-700 text-xs font-bold rounded-2xl text-center border cursor-pointer">
                    ファイルからデータを復元（追加）
                    <input type="file" accept=".json" onChange={e => handleImport(e, 'add')} className="hidden" />
                  </label>
                </div>
              </div>
            )}

          </main>

          {/* ナビゲーションバー */}
          <nav className="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white/90 backdrop-blur-md border-t border-slate-200 flex justify-around py-2 px-1 z-20 pb-safe">
            {[
              { id: 'home', label: 'ホーム', icon: '🏠' },
              { id: 'items', label: 'グッズ', icon: '📦' },
              { id: 'trades', label: '取引', icon: '🤝' },
              { id: 'stats', label: '集計', icon: '📊' },
              { id: 'settings', label: '設定', icon: '⚙️' }
            ].map(nav => (
              <button
                key={nav.id}
                onClick={() => setTab(nav.id)}
                className={`flex flex-col items-center py-1 px-3 rounded-xl ${tab === nav.id ? primaryText : 'text-slate-400'}`}
              >
                <span className="text-lg">{nav.icon}</span>
                <span className="text-[10px] font-medium">{nav.label}</span>
              </button>
            ))}
          </nav>

          {/* グッズ登録/編集モーダル */}
          {editingItem && (
            <div className="fixed inset-0 bg-black/50 z-40 flex items-end justify-center">
              <div className="bg-white w-full max-w-md rounded-t-3xl p-5 space-y-4 max-h-[90vh] overflow-y-auto">
                <div className="flex justify-between items-center border-b pb-3">
                  <h3 className="font-bold text-sm text-slate-800">グッズの登録</h3>
                  <button onClick={() => setEditingItem(null)} className="text-slate-400 text-lg font-bold">×</button>
                </div>
                <div className="space-y-3 text-xs">
                  <div>
                    <label className="font-bold text-slate-600">グッズ名 *</label>
                    <input
                      type="text"
                      value={editingItem.item_name || ''}
                      onChange={e => setEditingItem({ ...editingItem, item_name: e.target.value })}
                      className="w-full mt-1 p-3 bg-slate-50 border rounded-2xl text-xs"
                      placeholder="例：缶バッジ"
                    />
                  </div>
                  <div>
                    <label className="font-bold text-slate-600">作品名</label>
                    <input
                      type="text"
                      value={editingItem.work_title || ''}
                      onChange={e => setEditingItem({ ...editingItem, work_title: e.target.value })}
                      className="w-full mt-1 p-3 bg-slate-50 border rounded-2xl text-xs"
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="font-bold text-slate-600">数量（所持中）</label>
                      <input
                        type="number"
                        min="1"
                        value={editingItem.qty_owned || 1}
                        onChange={e => setEditingItem({ ...editingItem, qty_owned: Number(e.target.value), purchase_quantity: Number(e.target.value) })}
                        className="w-full mt-1 p-3 bg-slate-50 border rounded-2xl text-xs"
                      />
                    </div>
                    <div>
                      <label className="font-bold text-slate-600">購入単価（円）</label>
                      <input
                        type="number"
                        min="0"
                        value={editingItem.purchase_price || ''}
                        onChange={e => setEditingItem({ ...editingItem, purchase_price: e.target.value, has_price: !!e.target.value })}
                        className="w-full mt-1 p-3 bg-slate-50 border rounded-2xl text-xs"
                        placeholder="例：550"
                      />
                    </div>
                  </div>
                </div>
                <div className="pt-2 flex gap-2">
                  <button onClick={() => setEditingItem(null)} className="flex-1 py-3 bg-slate-100 text-slate-600 font-bold text-xs rounded-2xl">キャンセル</button>
                  <button
                    onClick={() => {
                      if (!editingItem.item_name) {
                        alert('グッズ名を入力してください');
                        return;
                      }
                      const newItem = {
                        ...editingItem,
                        id: editingItem.id || 'item_' + Date.now(),
                        created_at: editingItem.created_at || new Date().toISOString()
                      };
                      setItems(editingItem.id ? items.map(i => i.id === newItem.id ? newItem : i) : [newItem, ...items]);
                      setEditingItem(null);
                    }}
                    className={`flex-1 py-3 ${solidPrimary} text-white font-bold text-xs rounded-2xl shadow-md`}
                  >
                    保存する
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* グッズ詳細モーダル */}
          {viewingItem && (
            <div className="fixed inset-0 bg-black/50 z-40 flex items-end justify-center">
              <div className="bg-white w-full max-w-md rounded-t-3xl p-5 space-y-4 max-h-[90vh] overflow-y-auto">
                <div className="flex justify-between items-center border-b pb-3">
                  <div>
                    <span className="text-[10px] text-slate-400">{viewingItem.work_title}</span>
                    <h3 className="font-bold text-sm text-slate-800">{viewingItem.item_name}</h3>
                  </div>
                  <button onClick={() => setViewingItem(null)} className="text-slate-400 text-lg font-bold">×</button>
                </div>
                <div className="text-xs space-y-2">
                  <div className="bg-slate-50 p-3 rounded-2xl flex justify-between">
                    <span className="text-slate-500">所持中数量</span>
                    <span className="font-bold text-slate-800">{viewingItem.qty_owned} 個</span>
                  </div>
                </div>
                <div className="flex gap-2 pt-2">
                  <button
                    onClick={() => {
                      if (confirm('このグッズを削除しますか？')) {
                        setItems(items.filter(i => i.id !== viewingItem.id));
                        setViewingItem(null);
                      }
                    }}
                    className="w-full py-3 bg-rose-50 text-rose-600 font-bold text-xs rounded-2xl"
                  >
                    削除する
                  </button>
                </div>
              </div>
            </div>
          )}

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
